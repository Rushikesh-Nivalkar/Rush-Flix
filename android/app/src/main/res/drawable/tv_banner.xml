<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!--
        Rush Flix — Android TV / Leanback launcher banner (320×180dp).
        RF monogram centred on cinema-dark background.
    -->

    <!-- Background -->
    <path
        android:fillColor="#0A0A0A"
        android:pathData="M 0,0 h 320 v 180 h -320 Z"/>

    <!-- Left red accent bar -->
    <path
        android:fillColor="#E50914"
        android:pathData="M 0,0 h 5 v 180 h -5 Z"/>

    <!--
        RF Monogram — centred at (160, 90).
        Spans x=99–221, y=34–146 (122×112dp).
    -->

    <!-- R letterform -->
    <path
        android:fillColor="#E50914"
        android:pathData="
            M 99,34  h 13 v 110 h -13 Z
            M 99,34  h 48  v 13  h -48  Z
            M 136,34 h 13  v 45  h -13  Z
            M 99,68  h 48  v 13  h -48  Z
            M 136,81 L 147,81 L 163,146 L 152,146 Z"/>

    <!-- F letterform -->
    <path
        android:fillColor="#E50914"
        android:pathData="
            M 171,34 h 13  v 110 h -13  Z
            M 171,34 h 50  v 13  h -50  Z
            M 171,68 h 40  v 13  h -40  Z"/>

    <!-- Horizontal scan line -->
    <path
        android:fillColor="#E50914"
        android:alpha="0.28"
        android:pathData="M 97,100 h 127 v 2 h -127 Z"/>

</vector>
