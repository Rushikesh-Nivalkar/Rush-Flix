# Copy this to .env.local (git-ignored) — only needed when building Rush Flix yourself.

# Optional: pre-fill a TMDB token so the app skips the setup screen.
# Get it: themoviedb.org → Settings → API → API Read Access Token (long JWT starting with eyJ)
VITE_TMDB_TOKEN=

# Optional: GitHub fine-grained token with Issues: write on your repo, used by Settings → Feedback.
# Leave empty to disable in-app feedback submission.
VITE_FEEDBACK_TOKEN=
